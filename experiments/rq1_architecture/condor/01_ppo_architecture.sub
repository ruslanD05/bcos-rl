# Create the sweep locally first, then submit with:
# condor_submit experiments/rq1_architecture/condor/01_ppo_architecture.sub

universe = docker
docker_image = pytorch/pytorch:2.2.0-cuda12.1-cudnn8-runtime

executable = /bin/bash
arguments = experiments/rq1_architecture/condor/run_sweep_agent.sh minigrid_part/sweep_rq1_ppo_architecture.py rq1-minigrid-ppo-architecture-final b9ijitlp 1

initialdir = /home/rudo00002/bachelor_thesis_RL/bachelors_thesis_ruslan
output = experiments/rq1_architecture/condor/logs/ppo-architecture-$(ClusterId)-$(ProcId).out
error = experiments/rq1_architecture/condor/logs/ppo-architecture-$(ClusterId)-$(ProcId).err
log = experiments/rq1_architecture/condor/logs/ppo-architecture-$(ClusterId).log

request_cpus = 2
request_memory = 8GB
+WantScratchMounted = true
should_transfer_files = NO
stream_output = True
stream_error = True
getenv = WANDB_API_KEY

queue 10
