BCOS_B = 2.3

universe = docker
docker_image = pytorch/pytorch:2.2.0-cuda12.1-cudnn8-runtime

executable = /bin/bash
arguments = experiments/rq1_architecture/condor/run_sweep_agent.sh car_racing_part/sweep_rq1_carracing_architecture.py rq1-carracing-ppo-architecture-final-v2 qn529s0l 1 --bcos-b $(BCOS_B)

initialdir = /home/rudo00002/bachelor_thesis_RL/bachelors_thesis_ruslan
output = experiments/rq1_architecture/condor/logs/carracing-architecture-$(ClusterId)-$(ProcId).out
